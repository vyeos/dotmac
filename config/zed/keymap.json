// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space q": "diagnostics::Deploy",
      "space e": "vim::ToggleProjectPanelFocus",
      "space s": "outline::Toggle",
      "v g d": "editor::GoToDefinitionSplit",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {},
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-k": "editor::MoveLineUp",
      "shift-j": "editor::MoveLineDown",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "v d": "editor::Hover",
    },
  },
  {
    "context": "Picker > Editor",
    "unbind": {
      "ctrl-h": "editor::Backspace",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-h": ["vim::Literal", ["ctrl-h", "\b"]],
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-h": "editor::Backspace",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-k": ["vim::Literal", ["ctrl-k", "\u000b"]],
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k": "editor::KillRingCut",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-l": ["vim::Literal", ["ctrl-l", "\f"]],
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-l": "editor::ScrollCursorCenter",
    },
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "alt-cmd-l": "search::ToggleSelection",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-cmd-l": "search::ToggleSelection",
    },
    "bindings": {
      "ctrl-cmd-l": "pane::ActivateNextItem",
      "ctrl-cmd-h": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "alt-cmd-l": [
        "buffer_search::Deploy",
        {
          "selection_search_enabled": true,
        },
      ],
    },
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "alt-cmd-l": "agent::OpenRulesLibrary",
    },
  },
  {
    "unbind": {
      "alt-cmd-h": "zed::HideOthers",
    },
  },
  {
    "unbind": {
      "ctrl-cmd-l": "lsp_tool::ToggleMenu",
    },
  },
  {
    "context": "vim_mode == helix_select",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
]
