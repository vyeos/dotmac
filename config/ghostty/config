font-family = "Lilex"
font-size = 16

window-padding-x = 16

keybind = ctrl+enter=unbind
# theme = dark:Rose Pine Moon,light:Rose Pine Dawn
 theme = dark:TokyoNight Moon,light:TokyoNight Day
# theme = dark:Catppuccin Macchiato,light:Catppuccin Latte 

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing

notify-on-command-finish = unfocused
scrollbar = never

confirm-close-surface = false
shell-integration-features = no-cursor

macos-window-buttons = hidden
macos-titlebar-proxy-icon = visible

keybind = ctrl+k=goto_split:up
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+l=goto_split:right

keybind = super+ctrl+k=resize_split:up,50
keybind = super+ctrl+j=resize_split:down,50
keybind = super+ctrl+h=resize_split:left,50
keybind = super+ctrl+l=resize_split:right,50
